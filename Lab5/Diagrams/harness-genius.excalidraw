id", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r95"}, {"type": "text", "x": 1195, "y": 451.375, "width": 150, "height": 16.25, "strokeColor": "#1971c2", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Data Science", "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Data Science", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t96"}, {"type": "text", "x": 1195, "y": 469.625, "width": 150, "height": 25.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "cura y pasa a BD2\nsolo lo aprobado ★", "fontSize": 10, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "cura y pasa a BD2\nsolo lo aprobado ★", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t97"}, {"type": "arrow", "x": 1400, "y": 473, "width": 50, "height": 0, "strokeColor": "#5c5c5c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [-50, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a98"}, {"type": "arrow", "x": 1290, "y": 430, "width": 108, "height": 78, "strokeColor": "#1971c2", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [108, -78]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a99"}, {"type": "text", "x": 245, "y": 826, "width": 774, "height": 45.0, "strokeColor": "#c92a2a", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "El lazo se cierra por las bases, no por la conversación: el LLM responde, el ingeniero califica, lo calificado\ncae en BD3 como candidato y solo lo que se aprueba pasa a BD2, que es de donde el LLM vuelve a leer. Sin ese\nfiltro, una respuesta inventada con buen score se guardaría como verdad y el LLM la repetiría con más confianza. ★", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "El lazo se cierra por las bases, no por la conversación: el LLM responde, el ingeniero califica, lo calificado\ncae en BD3 como candidato y solo lo que se aprueba pasa a BD2, que es de donde el LLM vuelve a leer. Sin ese\nfiltro, una respuesta inventada con buen score se guardaría como verdad y el LLM la repetiría con más confianza. ★", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t100"}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}