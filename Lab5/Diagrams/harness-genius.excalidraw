ull, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a66"}, {"type": "arrow", "x": 1140, "y": 655, "width": 280, "height": 150, "strokeColor": "#1971c2", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [280, -150]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a67"}, {"type": "text", "x": 245, "y": 470, "width": 211, "height": 55.0, "strokeColor": "#e8590c", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Si el LLM se satura en el pico de\nla primera semana, el estado y\nlas respuestas aprobadas siguen\nsaliendo. ★", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "Si el LLM se satura en el pico de\nla primera semana, el estado y\nlas respuestas aprobadas siguen\nsaliendo. ★", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t68"}, {"type": "text", "x": 245, "y": 548, "width": 198, "height": 41.25, "strokeColor": "#c92a2a", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Lo que el cliente escribe en el\nticket es DATO, nunca una orden\npara el sistema. ★", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "Lo que el cliente escribe en el\nticket es DATO, nunca una orden\npara el sistema. ★", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t69"}, {"type": "text", "x": 245, "y": 622, "width": 186, "height": 41.25, "strokeColor": "#c92a2a", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "El LLM no tiene permiso para\nborrar: el permiso lo pone la\npersona que aprueba. ★", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "El LLM no tiene permiso para\nborrar: el permiso lo pone la\npersona que aprueba. ★", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t70"}, {"type": "rectangle", "x": 245, "y": 730, "width": 895, "height": 58, "strokeColor": "#868e96", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r71"}, {"type": "text", "x": 245, "y": 743.0, "width": 895, "height": 17.5, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Bitácora ★ — quién pidió, qué se respondió, quién aprobó", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 14, "containerId": null, "originalText": "Bitácora ★ — quién pidió, qué se respondió, quién aprobó", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t72"}, {"type": "text", 