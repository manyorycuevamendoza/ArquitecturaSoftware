    {
      "type": "text",
      "x": 1660,
      "y": 122,
      "width": 162,
      "height": 22.5,
      "text": "¿CÓMO FUNCIONA?",
      "originalText": "¿CÓMO FUNCIONA?",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null,
      "strokeColor": "#495057",
      "strokeWidth": 1.5,
      "id": "explain-label",
      "angle": 0,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 89,
      "version": 2,
      "versionNonce": 880028120,
      "isDeleted": false,
      "boundElements": [],
