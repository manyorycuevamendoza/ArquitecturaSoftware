      "height": 22.5,
      "text": "CRITERIOS HIPOTÉTICOS DE ESCALABILIDAD",
      "originalText": "CRITERIOS HIPOTÉTICOS DE ESCALABILIDAD",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null,
