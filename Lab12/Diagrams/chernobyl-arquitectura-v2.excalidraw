    {
      "type": "text",
      "x": 2220,
      "y": 152,
      "width": 410.4,
      "height": 22.5,
      "text": "CRITERIOS HIPOTÉTICOS DE ESCALABILIDAD",
      "originalText": "CRITERIOS HIPOTÉTICOS DE ESCALABILIDAD",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null,
      "strokeColor": "#495057",
