      "version": 1,
      "versionNonce": 52045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Disco y caché efímeros.\nAviso Spot → checkpoint best-effort.\nWorker ↔ local por mTLS autogestionado.\nSandbox nunca accede a PostgreSQL ni NAS.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
