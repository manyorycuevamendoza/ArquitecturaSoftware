    {
      "id": "spot-ephemeral-note",
      "type": "text",
      "x": 1170,
      "y": 605,
      "width": 310,
      "height": 70,
      "angle": 0,
      "strokeColor": "#9c4f00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
