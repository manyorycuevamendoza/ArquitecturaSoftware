    {
      "type": "text",
      "x": 1620,
      "y": 124,
      "width": 171.0,
      "height": 23.75,
      "text": "¿CÓMO FUNCIONA?",
      "originalText": "¿CÓMO FUNCIONA?",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null,
      "strokeColor": "#495057",
      "strokeWidth": 1.5,
      "id": "explain-label",
      "angle": 0,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 60,
      "version": 1,
      "versionNonce": 60,
      "isDeleted": false,
