"#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "Limpieza\ncaché", "fontSize": 12, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "Limpieza\ncaché", "lineHeight": 1.25, "seed": 1}, {"id": "t77", "type": "text", "x": 1010, "y": 850.125, "width": 150, "height": 13.75, "angle": 0, "strokeColor": "#6b7280", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "P5: RETIRADO olvidado", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "P5: RETIRADO olvidado", "lineHeight": 1.25, "seed": 1}, {"id": "a78", "type": "arrow", "x": 986, "y": 840, "width": 24, "height": 0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": {"type": 2}, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "points": [[0, 0], [24, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1}, {"id": "t79", "type": "text", "x": 688, "y": 874, "width": 140, "height": 12.5, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "0 bytes descargados", "fontSize": 10, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "0 bytes descargados", "lineHeight": 1.25, "seed": 1}, {"id": "l80", "type": "line", "x": 10, "y": 928, "width": 1190, "height": 0, "angle": 0, "strokeColor": "#d4d4d8", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "points": [[0, 0], [1190, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "seed": 1}, {"id": "t81", "type": "text", "x": 20, "y": 948, "width": 122, "height": 21.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "ITERACIÓN #3", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 17, "containerId": null, "originalText": "ITERACIÓN #3", "lineHeight": 1.25, "seed": 1}, {"id": "t82", "type": "text", "x": 20, "y": 972, "width": 270, "height": 16.25, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "Se descarga, se verifica y se activa", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Se descarga, se verifica y se activa", "lineHeight": 1.25, "seed": 1}, {"id": "t83", "type": "text", "x": 20, "y": 1004, "width": 283, "height": 450.0, "angle": 0, "strokeColor": "#3f3f46", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "10. Los casos NUEVO y EDITADO se escriben\n    en un plan de descarga en la base\n    local. Guía y ficha primero, el video\n    al final.\n\n11. El gestor baja por bloques con HTTP\n    Range. Si se corta la red, guarda\n    hasta dónde llegó.\n\n12. Al volver la señal pide solo los\n    rangos que faltan. Nunca reinicia\n    desde cero.\n\n13. Cada archivo completo se vuelve a\n    hashear y se compara contra el\n    manifiesto.\n\n14. Si el hash no coincide, se descarta y\n    la escuela sigue con la versión\n    anterior intacta. Nadie se queda sin\n    clase por un archivo roto.\n\n15. Si todo quedó listo, se mueve el\n    puntero de versión activa. Es una\n    sola operación: nunca hay media\n    versión visible.\n\n16. Rosa abre la app y el nodo le sirve\n    desde la caché por WiFi. Sin\n    Internet en ese momento.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "10. Los casos NUEVO y EDITADO se escriben\n    en un plan de descarga en la base\n    local. Guía y ficha primero, el video\n    al final.\n\n11. El gestor baja por bloques con HTTP\n    Range. Si se corta la red, guarda\n    hasta dónde llegó.\n\n12. Al volver la señal pide solo los\n    rangos que faltan. Nunca reinicia\n    desde cero.\n\n13. Cada archivo completo se vuelve a\n    hashear y se compara contra el\n    manifiesto.\n\n14. Si el hash no coincide, se descarta y\n    la escuela sigue con la versión\n    anterior intacta. Nadie se queda sin\n    clase por un archivo roto.\n\n15. Si todo quedó listo, se mueve el\n    puntero de versión activa. Es una\n    sola operación: nunca hay media\n    versión visible.\n\n16. Rosa abre la app y el nodo le sirve\n    desde la caché por WiFi. Sin\n    Internet en ese momento.", "lineHeight": 1.25, "seed": 1}, {"id": "r84", "type": "rectangle", "x": 350, "y": 968, "width": 830, "height": 424, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "roundness": {"type": 3}, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "seed": 1}, {"id": "t85", "type": "text", "x": 362, "y": 974, "width": 198, "height": 13.75, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "ESCUELA / NODO LOCAL (continúa)", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "ESCUELA / NODO LOCAL (continúa)", "lineHeight": 1.25, "seed": 1}, {"id": "e86", "type": "ellipse", "x": 392, "y": 1000, "width": 136, "height": 92, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": {"type": 2}, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "seed": 1}, {"id": "t87", "type": "text", "x": 392, "y": 1023.5, "width": 136, "height": 32.5, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "roundness": null, "boundElements": [], "updated": 1725494400000, "link": null, "locked": false, "text": "Plan de\ndescarga", "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Plan de\ndescarga", "lineHeight": 1.25