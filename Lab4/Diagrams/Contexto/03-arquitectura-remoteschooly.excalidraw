   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Cada componente del diagrama lleva en rojo los codigos que le corresponden. Si un caso no tiene componente que lo atienda, es un hueco del diseno.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
