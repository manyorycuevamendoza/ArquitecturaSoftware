ype": 2}, "points": [[0, 0], [0, 18]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a33"}, {"type": "text", "x": 20, "y": 390, "width": 290, "height": 135.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "3. Baja el manifiesto remoto, que pesa\n   unos KB, y lo cruza con el local. De\n   ahí salen cuatro casos y ninguno más.\n\n   Si la escuela se atrasó varias semanas\n   no hay nada especial que hacer: el\n   manifiesto describe el estado completo,\n   así que se compara contra el más nuevo\n   y ya está.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "3. Baja el manifiesto remoto, que pesa\n   unos KB, y lo cruza con el local. De\n   ahí salen cuatro casos y ninguno más.\n\n   Si la escuela se atrasó varias semanas\n   no hay nada especial que hacer: el\n   manifiesto describe el estado completo,\n   así que se compara contra el más nuevo\n   y ya está.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t34"}, {"type": "rectangle", "x": 366, "y": 386, "width": 830, "height": 180, "strokeColor": "#1971c2", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r35"}, {"type": "text", "x": 380, "y": 393, "width": 377, "height": 13.75, "strokeColor": "#1971c2", "strok