 "fillStyle": "solid", "backgroundColor": "transparent", "id": "a16"}, {"type": "arrow", "x": 748, "y": 224, "width": 232, "height": 0, "strokeColor": "#5c5c5c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [232, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a17"}, {"type": "text", "x": 790, "y": 200, "width": 120, "height": 12.5, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "cuando vuelve la red", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "cuando vuelve la red", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t18"}, {"type": "arrow", "x": 1000, "y": 262, "width": 250, "height": 26, "strokeColor": "#e8590c", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [-250, 26]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a19"}, {"type": "text", "x": 760, "y": 288, "width": 265, "height": 12.5, "strokeColor": "#e8590c", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "si no llega la confirmación, el nodo reintenta", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "si no llega la confirmación, el nodo reintenta", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t20"}, {"type": "line", "x": 10, "y": 424, "width": 1190, "height": 0, "strokeColor": "#d4d4d8", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": null, "points": [[0, 0], [1190, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "l21"}, {"type": "text", "x": 20, "y": 444, "width": 122, "height": 21.25, "strokeColor": "#1e1e1e", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "ITERACIÓN #2", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 17, "containerId": null, "originalText": "ITERACIÓN #2", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t22"}, {"type": "text", "x": 20, "y": 468, "width": 270, "height": 16.25, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "El identificador que no cambia nunca", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "El identificador que no cambia nunca", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t23"}, {"type": "text", "x": 20, "y": 500, "width": 283, "height": 360.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "6. Cada evento nace con un identificador\n   propio y ya no lo cambia nunca.\n\n7. El identificador junta tres cosas: qué\n   escuela, un contador local que solo\n   sube, y el hash del contenido.\n\n8. Se arma al crear el evento, no al\n   enviarlo. Esa es la diferencia que\n   sostiene todo lo demás.\n\n9. Cuando llega a Lima la pregunta es una\n   sola: ¿ya tengo un evento con este\n   identificador?\n\n10. Si no lo tengo, lo proceso y lo\n    guardo. Si ya lo tengo, respondo OK\n    otra vez y no lo vuelvo a procesar.\n\n11. Lima aplica el evento y guarda el\n    identificador en la misma\n    transacción. Si guardara después y se\n    cayera en el medio, el reintento lo\n    duplicaría igual.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "6. Cada evento nace con un identificador\n   propio y ya no lo cambia nunca.\n\n7. El identificador junta tres cosas: qué\n   escuela, un contador local que solo\n   sube, y el hash del contenido.\n\n8. Se arma al crear el evento, no al\n   enviarlo. Esa es la diferencia que\n   sostiene todo lo demás.\n\n9. Cuando llega a Lima la pregunta es una\n   sola: ¿ya tengo un evento con este\n   identificador?\n\n10. Si no lo tengo, lo proceso y lo\n    guardo. Si ya lo tengo, respondo OK\n    otra vez y no lo vuelvo a procesar.\n\n11. Lima aplica el evento y guarda el\n    identificador en la misma\n    transacción. Si guardara después y se\n    cayera en el medio, el reintento lo\n    duplicaría igual.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t24"}, {"type": "rectangle", "x": 350, "y": 496, "width": 840, "height": 366, "strokeColor": "#adb5bd", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r25"}, {"type": "text", "x": 362, "y": 502, "width": 211, "height": 13.75, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "IDEMPOTENCIA DEL RETORNO  ·  PD-3", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "IDEMPOTENCIA DEL RETORNO  ·  PD-3", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t26"}, {"type": "text", "x": 378, "y": 522, "width": 308, "height": 87.5, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "event_id  =  school_id  +  seq  +  hash(contenido)\n\nPE-AYA-041   -   0417   -   1f045c4e79d4\n  escuela      contador      hash del\n                local        contenido\n\nse arma al CREAR el evento, no al enviarlo", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "event_id  =  school_id  +  seq  +  hash(contenido)\n\nPE-AYA-041   -   0417   -   1f045c4e79d4\n  escuela      contador      hash del\n                local        contenido\n\nse arma al CREAR el evento, no al enviarlo", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t27"}, {"type": "rectangle", "x": 760, "y": 540, 