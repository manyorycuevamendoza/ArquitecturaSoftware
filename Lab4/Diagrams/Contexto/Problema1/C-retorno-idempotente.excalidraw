th": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r80"}, {"type": "text", "x": 760, "y": 1251.25, "width": 240, "height": 16.25, "strokeColor": "#e8590c", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Desviado en reintento", "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Desviado en reintento", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t81"}, {"type": "text", "x": 760, "y": 1269.5, "width": 240, "height": 11.25, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "el id no cambia: se congeló al crear", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "el id no cambia: se congeló al crear", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t82"}, {"type": "text", "x": 1020, "y": 1150, "width": 103, "height": 87.5, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "El reloj desviado\nnunca rompe la\nidempotencia.\nSolo ensucia la\nauditoría, y para\neso está el\nreceived_at.", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "El reloj desviado\nnunca rompe la\nidempotencia.\nSolo ensucia la\nauditoría, y para\neso está el\nreceived_at.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t83"}, {"type": "rectangle", "x": 372, "y": 1380, "width": 450, "height": 118, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r84"}, {"type": "text", "x": 386, "y": 1390, "width": 229, "height": 13.75, "strokeColor": "#1e1e1e", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "PEORES CASOS QUE ATAJA ESTE DIAGRAMA", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "PEORES CASOS QUE ATAJA ESTE DIAGRAMA", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t85"}, {"type": "text", "x": 386, "y": 1412, "width": 304, "height": 75.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "P6   el timestamp se toma al enviar y no al crear\nP7   Lima aplica el evento pero no guarda el event_id\nP8   la cola crece sin límite hasta llenar el disco\nP18  salto de reloj por NTP entre crear y reenviar\nP19  ordenar la auditoría por la hora del nodo\nP22  borrar la cola para liberar espacio", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "P6   el timestamp se toma al enviar y no al crear\nP7   Lima aplica el evento pero no guarda el event_id\nP8   la cola crece sin límite hasta llenar el disco\nP18  salto de reloj por NTP entre crear y reenviar\nP19  ordenar la auditoría por la hora del nodo\nP22  borrar la cola para liberar espacio", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t86"}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}