ead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a39"}, {"type": "rectangle", "x": 632, "y": 648, "width": 240, "height": 88, "strokeColor": "#e8590c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r40"}, {"type": "text", "x": 632, "y": 665.0, "width": 240, "height": 16.25, "strokeColor": "#e8590c", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Reintento", "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Reintento", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t41"}, {"type": "text", "x": 632, "y": 683.25, "width": 240, "height": 11.25, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "ya lo tengo, no confirmó", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "ya lo tengo, no confirmó", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t42"}, {"type": "text", "x": 632, "y": 696.5, "width": 240, "height": 22.5, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "no reprocesar,\nresponder OK otra vez", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "no reprocesar,\nresponder OK otra vez", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t43"}, {"type": "arrow", "x": 880, "y": 640, "width": 128, "height": 8, "strokeColor": "#5c5c5c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [-128, 8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a44"}, {"type": "rectangle", "x": 892, "y": 648, "width": 240, "height": 88, "strokeColor": "#c92a2a", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r45"}, {"type": "text", "x": 892, "y": 665.0, "width": 240, "height": 16.25, "strokeColor": "#c92a2a", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Duplicado real", "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Duplicado real", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t46"}, {"type": "text", "x": 892, "y": 683.25, "width": 240, "height": 11.25, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "ya lo tengo y ya confirmó", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "ya lo tengo y ya confirmó", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t47"}, {"type": "text", "x": 892, "y": 696.5, "width": 240, "height": 22.5, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "no reprocesar,\nregistrar como anomalía", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "no reprocesar,\nregistrar como anomalía", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t48"}, {"type": "arrow", "x": 880, "y": 640, "width": 132, "height": 8, "strokeColor": "#5c5c5c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [132, 8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a49"}, {"type": "text", "x": 372, "y": 752, "width": 562, "height": 25.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Aplicar el evento y guardar el event_id ocurren en la misma transacción. Si Lima aplicara primero y\nguardara después, un corte en el medio haría que el reintento lo procesara otra vez.", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "Aplicar el evento y guardar el event_id ocurren en la misma transacción. Si Lima aplicara primero y\nguardara después, un corte en el medio haría que el reintento lo procesara otra vez.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t50"}, {"type": "text", "x": 372, "y": 800, "width": 500, "height": 25.0, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Nominalmente 2 x 3 = 6 filas. Cuando no tengo el event_id la segunda variable no aplica:\nesas filas colapsan en una sola. Quedan 3 casos.", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "Nominalmente 2 x 3 = 6 filas. Cuando no tengo el event_id la segunda variable no aplica:\nesas filas colapsan en una sola. Quedan 3 casos.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t51"}, {"type": "line", "x": 10, "y": 880, "width": 1190, "height": 0, "strokeColor": "#d4d4d8", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": null, "points": [[0, 0], [1190, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "l52"}, {"type": "text", "x": 20, "y": 900, "width": 122, "height": 21.25, "strokeColor": "#1e1e1e", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "ITERACIÓN #3", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 17, "containerId": null, "originalText": "ITERACIÓN #3", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t53"}, {"type": "text", "x": 20, "y": 924, "width": 226, "height": 16.25, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "El reloj del nodo puede mentir", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "El reloj del nodo puede mentir", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t54"}, {"type": "text", "x": 20, "y": 956, "width": 283, "height": 390.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "12. El nodo puede tener el reloj mal. Un\n    corte largo de energía y arranca en\n    una fecha por defecto.\n\n13. Eso no rompe la idempotencia, porque\n    el identificador ya se congeló cuando\n    se creó el evento.\n\n14. Lo que sí rompe es la auditoría: el\n    orden de los eventos deja de ser\n    confiable.\n\n15. Por eso se guardan dos tiempos\n    distintos. created_at lo pone el nodo\n    y cuenta cuándo pasó en la escuela.\n    received_at lo pone Lima y sirve para\n    ordenar.\n\n16. Los reportes ordenan por received_at,\n    nunca por la hora del nodo.\n\n17. Si el timestamp se tomara al enviar,\n    cada reintento generaría un\n    identificador distinto y el duplicado\n    se colaría. Por eso el contador local\n    reemplaza al reloj dentro del id.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "12. El nodo puede tener el reloj mal. Un\n    corte largo de energía y arranca en\n    una fecha por defecto.\n\n13. Eso no rompe la idempotencia, porque\n    el identificador ya se congeló cuando\n    se creó el evento.\n\n14. Lo que sí rompe es la auditoría: el\n    orden de los eventos deja de ser\n    confiable.\n\n15. Por eso se guardan dos tiempos\n    distintos. created_at lo pone el nodo\n    y cuenta cuándo pasó en la escuela.\n    received_at lo pone Lima y sirve para\n    ordenar.\n\n16. Los reportes ordenan por received_at,\n    nunca por la hora del nodo.\n\n17. Si el timestamp se tomara al enviar,\n    cada reintento generaría un\n    identificador distinto y el duplicado\n    se colaría. Por eso el contador local\n    reemplaza al reloj dentro del id.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t55"}, {"type": "rectangle", "x": 350, "y": 976, "width": 840, "height": 380, "strokeColor": "#adb5bd", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r56"}, {"type": "text", "x": 362, "y": 982, "width": 217, "height": 13.75, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "DOS RELOJES, DOS TRABAJOS  ·  PD-6", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "DOS RELOJES, DOS TRABAJOS  ·  PD-6", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], 