d": "a27"}, {"type": "arrow", "x": 924, "y": 258, "width": 222, "height": 56, "strokeColor": "#e8590c", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "roundness": {"type": 2}, "points": [[0, 0], [-222, 56]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "a28"}, {"type": "text", "x": 800, "y": 330, "width": 209, "height": 12.5, "strokeColor": "#e8590c", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "cualquiera de las tres que dé que no", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "cualquiera de las tres que dé que no", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t29"}, {"type": "line", "x": 10, "y": 454, "width": 1190, "height": 0, "strokeColor": "#d4d4d8", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": null, "points": [[0, 0], [1190, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "l30"}, {"type": "text", "x": 20, "y": 474, "width": 122, "height": 21.25, "strokeColor": "#1e1e1e", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "ITERACIÓN #2", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 17, "containerId": null, "originalText": "ITERACIÓN #2", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t31"}, {"type": "text", "x": 20, "y": 498, "width": 313, "height": 16.25, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "¿Ahora o después? La clase tiene prioridad", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "¿Ahora o después? La clase tiene prioridad", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t32"}, {"type": "text", "x": 20, "y": 530, "width": 283, "height": 330.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "6. Tres variables: hay señal, es horario\n   de clase, hay energía.\n\n7. Ocho combinaciones nominales. Cuando\n   no hay señal las otras dos dejan de\n   importar, así que cuatro filas\n   colapsan en una. Quedan cinco.\n\n8. La regla que ordena todo no es\n   aprovechar cada ventana de red. Es no\n   estorbar la clase que está pasando.\n\n9. Una sincronización agresiva a mediodía\n   satura el enlace y la LAN. Rosa no\n   puede abrir una guía que ya está en el\n   nodo. El sistema se rompe a sí mismo\n   con su propia tarea de fondo.\n\n10. Y si las 500 escuelas entran a la\n    misma hora, el pico cae entero sobre\n    Lima. Por eso cada escuela espera un\n    rato distinto dentro de la ventana.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "6. Tres variables: hay señal, es horario\n   de clase, hay energía.\n\n7. Ocho combinaciones nominales. Cuando\n   no hay señal las otras dos dejan de\n   importar, así que cuatro filas\n   colapsan en una. Quedan cinco.\n\n8. La regla que ordena todo no es\n   aprovechar cada ventana de red. Es no\n   estorbar la clase que está pasando.\n\n9. Una sincronización agresiva a mediodía\n   satura el enlace y la LAN. Rosa no\n   puede abrir una guía que ya está en el\n   nodo. El sistema se rompe a sí mismo\n   con su propia tarea de fondo.\n\n10. Y si las 500 escuelas entran a la\n    misma hora, el pico cae entero sobre\n    Lima. Por eso cada escuela espera un\n    rato distinto dentro de la ventana.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t33"}, {"type": "rectangle", "x": 350, "y": 502, "width": 840, "height": 372, "strokeColor": "#adb5bd", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r34"}, {"type": "text", "x": 362, "y": 508, "width": 242, "height": 13.75, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "¿SINCRONIZAR AHORA O ESPERAR?  ·  PD-7", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "¿SINCRONIZAR AHORA O ESPERAR?  ·  PD-7", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t35"}, {"type": "rectangle", "x": 470, "y": 522, "width": 175, "height": 52, "strokeColor": "#0c8599", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "se