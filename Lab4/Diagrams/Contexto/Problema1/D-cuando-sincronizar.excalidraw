calAlign": "top", "baseline": 11, "containerId": null, "originalText": "VENTANA IDEAL", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t52"}, {"type": "text", "x": 537, "y": 741.625, "width": 155, "height": 22.5, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "sincronizar a fondo,\nincluido lo opcional", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "sincronizar a fondo,\nincluido lo opcional", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t53"}, {"type": "rectangle", "x": 702, "y": 702, "width": 155, "height": 86, "strokeColor": "#e8590c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r54"}, {"type": "text", "x": 702, "y": 725.875, "width": 155, "height": 13.75, "strokeColor": "#e8590c", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "SIN ENERGÍA", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "SIN ENERGÍA", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t55"}, {"type": "text", "x": 702, "y": 741.625, "width": 155, "height": 22.5, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "no iniciar; se gasta\nla ventana en vano", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "no iniciar; se gasta\nla ventana en vano", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t56"}, {"type": "rectangle", "x": 867, "y": 702, "width": 155, "height": 86, "strokeColor": "#e8590c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r57"}, {"type": "text", "x": 867, "y": 725.875, "width": 155, "height": 13.75, "strokeColor": "#e8590c", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "HAY CLASE", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "HAY CLASE", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t58"}, {"type": "text", "x": 867, "y": 741.625, "width": 155, "height": 22.5, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "sincronizar con tope\nde ancho de banda", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "sincronizar con tope\nde ancho de banda", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t59"}, {"type": "rectangle", "x": 1032, "y": 702, "width": 155, "height": 86, "strokeColor": "#c92a2a", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r60"}, {"type": "text", "x": 1032, "y": 719.0, "width": 155, "height": 27.5, "strokeColor": "#c92a2a", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "CLASE Y POCA\nENERGÍA", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "CLASE Y POCA\nENERGÍA", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t61"}, {"type": "text", "x": 1032, "y": 748.5, "width": 155, "height": 22.5, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "no sincronizar; todo\nva a servir la LAN", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "no sincronizar; todo\nva a servir la LAN", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t62"}, {"type": "text", "x": 372, "y": 800, "width": 584, "height": 25.0, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Nominalmente 2 x 2 x 2 = 8 filas. Cuando no hay señal no se puede transferir sin importar el horario ni\nla energía, así que esas cuatro combinaciones colapsan en una sola. Quedan 5 casos.", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "Nominalmente 2 x 2 x 2 = 8 filas. Cuando no hay señal no se puede transferir sin importar el horario ni\nla energía, así que esas cuatro combinaciones colapsan en una sola. Quedan 5 casos.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t63"}, {"type": "text", "x": 372, "y": 838, "width": 562, "height": 12.5, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "Las 500 escuelas no entran a la misma hora: cada una espera un rato aleatorio dentro de la ventana.", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "Las 500 escuelas no entran a la misma hora: cada una espera un rato aleatorio dentro de la ventana.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t64"}, {"type": "line", "x": 10, "y": 900, "width": 1190, "height": 0, "strokeColor": "#d4d4d8", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": null, "points": [[0, 0], [1190, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "l65"}, {"type": "text", "x": 20, "y": 920, "width": 122, "height": 21.25, "strokeColor": "#1e1e1e", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "ITERACIÓN #3", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 17, "containerId": null, "originalText": "ITERACIÓN #3", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t66"}, {"type": "text", "x": 20, "y": 944, "width": 226, "height": 16.25, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "¿Cuánto me atrasé? ¿Y me cabe?", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "¿Cuánto me atrasé? ¿Y me cabe?", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t67"}, {"type": "text", "x": 20, "y": 976, "width": 290, "height": 465.0, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "11. El manifiesto no dice qué cambió esta\n    semana. Dice qué debe tener la\n    escuela hoy.\n\n12. Con eso, saltarse tres semanas deja de\n    ser un caso especial: es el mismo\n    algoritmo de comparar dos listas del\n    diagrama A.\n\n13. La escuela que quedó en la semana 9\n    lee el manifiesto de la 12 y baja\n    185 MB, no 369. La guía viaja una\n    sola vez, en su versión final.\n\n14. Diego no pierde el material de las\n    semanas sin señal: sigue vigente en\n    ese manifiesto.\n\n15. Después viene el disco. La activación\n    atómica necesita la versión activa y\n    la nueva al mismo tiempo. Por eso el\n    mínimo por nodo no es 4 GB sino 8.\n\n16. Si no cabe, se libera en orden:\n    primero multimedia vieja, después\n    versiones antiguas completas. Nunca\n    la versión activa ni la cola.\n\n17. La regla que ordena el borrado es que\n    lo que solo existe en la escuela vale\n    más que lo que Lima puede reenviar.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "11. El manifiesto no dice qué cambió esta\n    semana. Dice qué debe tener la\n    escuela hoy.\n\n12. Con eso, saltarse tres semanas deja de\n    ser un caso especial: es el mismo\n    algoritmo de comparar dos listas del\n    diagrama A.\n\n13. La escuela que quedó en la semana 9\n    lee el manifiesto de la 12 y baja\n    185 MB, no 369. La guía viaja una\n    sola vez, en su versión final.\n\n14. Diego no pierde el material de las\n    semanas sin señal: sigue vigente en\n    ese manifiesto.\n\n15. Después viene el disco. La activación\n    atómica necesita la versión activa y\n    la nueva al mismo tiempo. Por eso el\n    mínimo por nodo no es 4 GB sino 8.\n\n16. Si no cabe, se libera en orden:\n    primero multimedia vieja, después\n    versiones antiguas completas. Nunca\n    la versión activa ni la cola.\n\n17. La regla que ordena el borrado es que\n    lo que solo existe en la escuela vale\n    más que lo que Lima puede reenviar.", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t68"}, {"type": "rectangle", "x": 350, "y": 976, "width": 840, "height": 232, "strokeColor": "#adb5bd", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r69"}, {"type": "text", "x": 362, "y": 982, "width": 174, "height": 13.75, "strokeColor": "#868e96", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "¿CUÁNTO ME ATRASÉ?  ·  PD-4", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "¿CUÁNTO ME ATRASÉ?  ·  PD-4", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t70"}, {"type": "rectangle", "x": 372, "y": 1004, "width": 155, "height": 94, "strokeColor": "#2f9e44", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "roundness": {"type": 3}, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "r71"}, {"type": "text", "x": 372, "y": 1030.875, "width": 155, "height": 13.75, "strokeColor": "#2f9e44", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "AL DÍA", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "AL DÍA", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t72"}, {"type": "text", "x": 372, "y": 1046.625, "width": 155, "height": 11.25, "strokeColor": "#3f3f46", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "roundness": null, "text": "no hay nada nuevo", "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "no hay nada nuevo", "lineHeight": 1.25, "seed": 1, "updated": 1725494400000, "link": null, "locked": false, "angle": 0, "opacity": 100, "groupIds": [], "boundElements": [], "fillStyle": "solid", "backgroundColor": "transparent", "id": "t73"}, {"type": "text", "x": 372, "y": 1059.